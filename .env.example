# ─── MIDFLOW server configuration ───────────────────────────────────────────
# Copy to .env and fill in. These values stay on the server; never prefix them with VITE_.

# AI (text). Create a key at https://aistudio.google.com/app/apikey (new keys start with "AQ.", older ones with "AIza").
GEMINI_API_KEY=
# Optional alternative provider:
# OPENAI_API_KEY=
# AI_PROVIDER=gemini            # gemini | openai | none (default: first key found)
AI_MODEL=gemini-3.5-flash-lite # fast; scored 93/100 in npm run eval (2026-10-31)
AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash   # tried in order if the main model hits quota/overload
# AI_IMAGE_MODEL=gemini-3.1-flash-lite-image   # Nano Banana 2 Lite, ~US$0.034/image (paid tier only). Empty = curated photos only

# AI images: every generated post/story gets one (and the editor's "Gerar nova imagem IA"). Without these, cards use stock photos.
# Free option for testing — Cloudflare Workers AI (free daily allowance):
#   1. dash.cloudflare.com → copy the Account ID (right sidebar of any zone, or Workers & Pages page)
#   2. My Profile → API Tokens → Create Token → template "Workers AI" → copy the token
CF_AI_ACCOUNT_ID=
CF_AI_TOKEN=
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# IMAGE_PROVIDER=cloudflare     # cloudflare | gemini | none (default: Cloudflare if configured, else Gemini)
# AI_IMAGES_AUTO=true           # false = AI images only from the editor button

# Stock photo fallback when AI images fail or hit the limit. Free key: https://www.pexels.com/api/
# (Pexels and the photographer must be credited in the UI before a public launch.)
PEXELS_API_KEY=

# Quality gate
# AI_MIN_QUALITY=85             # 0–100; below this the AI revises its own text
# AI_REPAIR_ROUNDS=1
# AI_TIMEOUT_MS=90000
# AI_MAX_RETRIES=2
# AI_REQUIRE_LLM=false          # true = answer "AI unavailable" instead of using templates

# Protects GET /api/admin/metrics (POC dashboard). Use a long random value.
ADMIN_TOKEN=

# Hosting
# PORT=3000
# NODE_ENV=production
# TRUST_PROXY=true              # behind Render/Railway/Fly/nginx
# ALLOWED_ORIGINS=              # extra origins allowed to call the API (comma separated)

# Per-IP hourly limits
# RATE_GENERATE_PER_HOUR=30
# RATE_REWRITE_PER_HOUR=120
# RATE_AI_IMAGE_PER_HOUR=160    # 8 images per generation
