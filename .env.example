# ─── MIDFLOW server configuration ───────────────────────────────────────────
# Copy to .env and fill in. These values stay on the server; never prefix them with VITE_.

# AI (text). Create a key at https://aistudio.google.com/app/apikey (new keys start with "AQ.", older ones with "AIza").
GEMINI_API_KEY=
# Optional alternative provider:
# OPENAI_API_KEY=
# AI_PROVIDER=gemini            # gemini | openai | none (default: first key found)
AI_MODEL=gemini-3.5-flash-lite # fast; scored 93/100 in npm run eval (2026-10-31)
AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash   # tried in order if the main model hits quota/overload
# AI_IMAGE_MODEL=gemini-3.1-flash-lite-image   # Nano Banana 2 Lite, ~US$0.034/image (paid tier only). Empty = curated photos only

# AI images: every generated post/story gets one (and the editor's "Gerar nova imagem IA"). Without these, cards use stock photos.
# Free option for testing — Cloudflare Workers AI (free daily allowance):
#   1. dash.cloudflare.com → copy the Account ID (right sidebar of any zone, or Workers & Pages page)
#   2. My Profile → API Tokens → Create Token → template "Workers AI" → copy the token
CF_AI_ACCOUNT_ID=
CF_AI_TOKEN=
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# IMAGE_PROVIDER=cloudflare     # cloudflare | gemini | none (default: Cloudflare if configured, else Gemini)
# AI_IMAGES_AUTO=true           # false = AI images only from the editor button

# Stock photo fallback when AI images fail or hit the limit. Free key: https://pixabay.com/api/docs/
# (Pixabay asks apps to show where the photos come from.)
PIXABAY_API_KEY=

# Quality gate
# AI_MIN_QUALITY=85             # 0–100; below this the AI revises its own text
# AI_REPAIR_ROUNDS=1
# AI_TIMEOUT_MS=90000
# AI_MAX_RETRIES=2
# AI_REQUIRE_LLM=false         # DEPRECATED, still read but ignored. When the AI fails the API now always answers with the
#                               # honest template result (engine "template") plus aiErrorKind / retryable; the client retries on its own.

# Break-glass admin credential for /api/admin/* and the details in GET /api/status. At least 32 random characters
# (a shorter value is ignored with a warning), for example: openssl rand -base64 32
# Day-to-day staff sign in with their own account instead (roles admin / editor in the staff_members table).
ADMIN_TOKEN=

# Accounts and database (Supabase). Optional: without them the app keeps working anonymously with local storage,
# there are no per-plan quotas, no review queue storage and no staff roles (only ADMIN_TOKEN works for admin routes).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=    # secret: bypasses Row Level Security, server only
# SUPABASE_JWT_SECRET=          # legacy JWT secret (Project Settings > API > JWT Settings), verifies user tokens (HS256)

# Billing (Stripe Checkout + webhooks). Optional: without STRIPE_SECRET_KEY the billing routes answer 503.
# STRIPE_SECRET_KEY=            # sk_test_... or sk_live_...
# STRIPE_WEBHOOK_SECRET=        # whsec_... of the endpoint https://<domain>/midflow-app/api/billing/webhook
# STRIPE_PRICE_START=           # monthly price ids (server side so the browser can never choose a price)
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
# STRIPE_PRICE_START_ANNUAL=    # optional annual price ids
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_BUSINESS_ANNUAL=
# APP_URL=https://voaneves.com/midflow-app   # used for Checkout success / cancel URLs

# Client build (Vite) variables are public by design and live in the build environment, not here:
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY (anon key only, never the service role key) and VITE_BILLING_ENABLED.

# Who may use the paid AI. A request without a signed-in account (the "demo" included) can burn the daily AI budget,
# so with Supabase accounts configured it only gets the honest template result (engine "template").
# ANON_AI=template              # open = anonymous callers reach the AI | template = templates only | off = 401 asking to sign in
#                               # default: template when SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are set, open otherwise

# Signs the AI image URLs (/api/image?ai=1&sig=...) so only URLs this server issued can spend the image model.
# Required in production: without it AI card images are turned off (stock photos are served). Random, >= 32 chars; rotating it
# invalidates old AI image links (they fall back to stock photos).
# IMAGE_URL_SECRET=

# Hosting
# PORT=3000
# NODE_ENV=production
# TRUST_PROXY=cloudflare        # behind Cloudflare: trust only CF-Connecting-IP. Or a number N = proxies in front (rightmost-Nth X-Forwarded-For entry). Unset = socket address.
# ALLOWED_ORIGINS=              # extra origins allowed to call the API (comma separated)

# Per-IP hourly limits
# RATE_GENERATE_PER_HOUR=30
# RATE_REWRITE_PER_HOUR=120
# RATE_AI_IMAGE_PER_HOUR=160    # 8 images per generation
# RATE_IMAGE_PER_HOUR=1500      # GET /api/image (stock / cached images) per IP
# RATE_EVENTS_PER_HOUR=600      # POST /api/feedback and /api/event per IP
# RATE_REVIEW_PER_HOUR=10       # POST /api/review per IP
# RATE_BILLING_PER_HOUR=30      # POST /api/billing/checkout and /api/billing/portal per IP
# RATE_ACCOUNT_DELETE_PER_HOUR=5 # POST /api/account/delete per IP
# RATE_TEST_AI_PER_HOUR=5       # POST /api/test-ai (a real, billed model call) per IP

# Global daily caps on paid AI calls (all visitors together, counted per UTC day). Unset = unlimited.
# When a cap is reached the app answers with the template engine / stock photos and reports it honestly
# (engine "template"), instead of returning an error. 0 = never call the AI.
# AI_DAILY_MAX_TEXT=500         # /api/generate + /api/rewrite calls that may use the text model
# AI_DAILY_MAX_IMAGES=2000      # AI images generated (cache hits are not counted)
# RATE_GENERATE_IMAGE_PER_HOUR=120   # per-IP limit for POST /api/generate-image
# AI_DAILY_MAX_REWRITE=300             # rewrites have their own global budget (separate from AI_DAILY_MAX_TEXT, so they never starve /api/generate)
# AI_DAILY_MAX_REWRITE_PER_USER=60     # rewrites per signed-in account per UTC day (per IP for anonymous callers when ANON_AI=open)
# AI_DAILY_MAX_IMAGES_PER_USER=40      # AI images per signed-in account per UTC day (editor + signed card image URLs from /api/generate)
# IMAGE_TIMEOUT_MS=60000               # image model timeout
# MAX_BODY_BYTES=262144                # JSON request body cap

# Observability and data retention
# GIT_SHA=                      # shown as "version" in GET /api/health (set by CI); falls back to the package.json version
# LOG_REQUESTS=true             # one JSON log line per API request (method, path, status, ms, requestId); no bodies, tokens or IPs
# REVIEWS_RETENTION_DAYS=365    # resolved review requests older than this are deleted from Supabase, at most once a day (0 = keep)
# GENERATIONS_RETENTION_DAYS=0  # synced generations older than this are deleted from Supabase (0 = keep, the default)
# EVENTS_RETENTION_DAYS=90      # events older than this are pruned from server/data/events.jsonl and from the ai_events table (0 = keep forever)

# VITE_API_URL is a BUILD-TIME, browser-visible variable (never put a secret in it). It is only needed when the API runs on another
# origin than the site; leave it unset when the API is served under the same origin / Pages base.

# Note: ADMIN_TOKEN is accepted only as "Authorization: Bearer <token>" (the ?token= query parameter is no longer supported).
