{
  "name": "midflow-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "start": "node --env-file-if-exists=.env server/server.ts",
    "server": "node --env-file-if-exists=.env server/server.ts",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "node --test \"server/tests/*.test.ts\"",
    "eval": "node --env-file-if-exists=.env server/eval.ts",
    "preview": "vite preview",
    "check:ai": "node --env-file-if-exists=.env server/tools/check-ai.ts",
    "check:image": "node --env-file-if-exists=.env server/tools/check-image.ts",
    "worker:dev": "wrangler dev --local",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true,
    "esbuild@0.28.2": true
  }
}
