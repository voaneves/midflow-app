// Cloudflare Worker that hosts the MIDFLOW API at voaneves.com/midflow-app/api/*
// Deployed by .github/workflows/deploy.yml. Local test:  npm run worker:dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midflow-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "voaneves.com/midflow-app/api/*", "zone_name": "voaneves.com" }],
  // Non-secret settings. Secrets (GEMINI_API_KEY, CF_ACCOUNT_ID, CF_API_TOKEN, ADMIN_TOKEN) come from GitHub Secrets.
  "vars": {
    "NODE_ENV": "production",
    "AI_MODEL": "gemini-3.5-flash-lite",
    "AI_FALLBACK_MODELS": "gemini-3.1-flash-lite,gemini-3.5-flash",
    "AI_TIMEOUT_MS": "60000",
    "AI_MAX_RETRIES": "1",
    "TRUST_PROXY": "true"
  },
  "observability": { "enabled": true }
}
